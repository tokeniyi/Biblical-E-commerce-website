  "dependencies": {
    "@your-app/shared": "workspace:*",
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@prisma/client": "latest"
  },
  "devDependencies": {
    "@nestjs/testing": "latest",
    "jest": "^29.7.0",
    "prisma": "latest",
    "typescript": "^5.4.0"
  }
}
